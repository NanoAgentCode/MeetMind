# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=200

# ASR：demo 开箱即用但只返回示例转写；openai 调用兼容接口
ASR_BACKEND=demo
ASR_MODEL=whisper-1

# OpenAI：可同时供 ASR 和 OpenAI LLM 使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM
# demo | openai | anthropic | ollama | vllm
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# vLLM
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# RustFS
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=huizhi-local-access
RUSTFS_SECRET_KEY=huizhi-local-secret-change-before-production
RUSTFS_BUCKET=huizhi-meetings
RUSTFS_REGION=us-east-1
