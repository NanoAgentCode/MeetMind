# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=200
BACKGROUND_AUDIO_MB=20
# 无法从供应商获取模型上下文窗口时的回退值（token）
CHAT_CONTEXT_WINDOW_TOKENS=262144
# 首次启动前设置管理员账号与强密码；已初始化后修改密码需走后续账号管理功能
ADMIN_USERNAME=
ADMIN_PASSWORD=
# HTTPS 部署时改为 true
COOKIE_SECURE=false

# SQLite
DATABASE_PATH=backend/data/meetmind.db

# ASR、LLM 和 RAG 的供应商、模型与 API Key 在前端「模型服务」中配置。
# 未配置默认 ASR/LLM 模型时，后端使用演示转写/纪要。

# RustFS
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=huizhi-local-access
RUSTFS_SECRET_KEY=huizhi-local-secret-change-before-production
RUSTFS_BUCKET=huizhi-meetings
RUSTFS_REGION=us-east-1
